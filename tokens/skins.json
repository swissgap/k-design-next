        "300": { "$value": "{palette.moss.300}", "$type": "color" },
        "400": { "$value": "{palette.moss.400}", "$type": "color" },
        "500": { "$value": "{palette.moss.500}", "$type": "color" },
        "600": { "$value": "{palette.moss.600}", "$type": "color" },
        "700": { "$value": "{palette.moss.700}", "$type": "color" },
        "800": { "$value": "{palette.moss.800}", "$type": "color" },
