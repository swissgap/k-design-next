        "100": { "$value": "{palette.blue.100}", "$type": "color" },
        "200": { "$value": "{palette.blue.200}", "$type": "color" },
        "300": { "$value": "{palette.blue.300}", "$type": "color" },
        "400": { "$value": "{palette.blue.400}", "$type": "color" },
        "500": { "$value": "{palette.blue.500}", "$type": "color" },
        "600": { "$value": "{palette.blue.600}", "$type": "color" },
        "700": { "$value": "{palette.blue.700}", "$type": "color" },
        "800": { "$value": "{palette.blue.800}", "$type": "color" },
        "900": { "$value": "{palette.blue.900}", "$type": "color" }
      },
      "secondary": {
        "400": { "$value": "#5076b3", "$type": "color" },
        "500": { "$value": "#234dc2", "$type": "color" },
        "600": { "$value": "#1e40af", "$type": "color" },
