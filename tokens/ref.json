      "700": { "$value": "#b45309", "$type": "color" },
      "900": { "$value": "#78350f", "$type": "color" }
    },
    "violet": {
      "$description": "Fokusring — im swiss/designsystem ring-purple-500, in Oblique #8b5cf6",
      "300": { "$value": "#c4b5fd", "$type": "color" },
      "400": { "$value": "#a78bfa", "$type": "color" },
      "500": { "$value": "#8655f6", "$type": "color" },
