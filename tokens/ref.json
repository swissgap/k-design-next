    },
    "swiss": {
      "flag": { "$value": "#ff0000", "$type": "color", "$description": "Wappenschild — ausschliesslich für das Bundeslogo, nie für UI-Flächen" }
    }
  },

  "brand": {
    "$description": "Skin-Schicht. Skins (intranet, freebrand) überschreiben ausschliesslich diese Aliase — sys/cmp bleiben unberührt.",
    "primary": {
      "50":  { "$value": "{palette.red.50}",  "$type": "color" },
      "100": { "$value": "{palette.red.100}", "$type": "color" },
      "200": { "$value": "{palette.red.200}", "$type": "color" },
      "300": { "$value": "{palette.red.300}", "$type": "color" },
      "400": { "$value": "{palette.red.400}", "$type": "color" },
      "500": { "$value": "{palette.red.500}", "$type": "color" },
      "600": { "$value": "{palette.red.600}", "$type": "color" },
      "700": { "$value": "{palette.red.700}", "$type": "color" },
      "800": { "$value": "{palette.red.800}", "$type": "color" },
      "900": { "$value": "{palette.red.900}", "$type": "color" }
    },
    "secondary": {
      "50":  { "$value": "{palette.steel.50}",  "$type": "color" },
      "100": { "$value": "{palette.steel.100}", "$type": "color" },
      "200": { "$value": "{palette.steel.200}", "$type": "color" },
      "300": { "$value": "{palette.steel.300}", "$type": "color" },
      "400": { "$value": "{palette.steel.400}", "$type": "color" },
      "500": { "$value": "{palette.steel.500}", "$type": "color" },
      "600": { "$value": "{palette.steel.600}", "$type": "color" },
      "700": { "$value": "{palette.steel.700}", "$type": "color" },
      "800": { "$value": "{palette.steel.800}", "$type": "color" },
      "900": { "$value": "{palette.steel.900}", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "sans": { "$value": "'Noto Sans', 'Noto Sans Fallback', Verdana, Geneva, Tahoma, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'Noto Sans Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },
    "size": {
      "3xs": { "$value": "0.6875rem", "$type": "dimension" },
      "2xs": { "$value": "0.75rem",   "$type": "dimension" },
      "xs":  { "$value": "0.8125rem", "$type": "dimension" },
      "sm":  { "$value": "0.875rem",  "$type": "dimension" },
      "md":  { "$value": "1rem",      "$type": "dimension" },
      "lg":  { "$value": "1.125rem",  "$type": "dimension" },
      "xl":  { "$value": "1.25rem",   "$type": "dimension" },
      "2xl": { "$value": "1.375rem",  "$type": "dimension" },
      "3xl": { "$value": "1.625rem",  "$type": "dimension" },
      "4xl": { "$value": "2rem",      "$type": "dimension" },
      "5xl": { "$value": "2.5rem",    "$type": "dimension" },
      "6xl": { "$value": "3rem",      "$type": "dimension" },
      "7xl": { "$value": "3.5rem",    "$type": "dimension" },
      "8xl": { "$value": "4rem",      "$type": "dimension" },
      "9xl": { "$value": "5rem",      "$type": "dimension" }
    },
    "leading": {
      "none":    { "$value": "1",    "$type": "number" },
      "tight":   { "$value": "1.15", "$type": "number" },
      "snug":    { "$value": "1.3",  "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.65", "$type": "number" }
    },
    "tracking": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em",     "$type": "dimension" },
      "wide":   { "$value": "0.06em",  "$type": "dimension" },
      "wider":  { "$value": "0.12em",  "$type": "dimension" }
    }
  },

  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.25rem", "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "7":  { "$value": "1.75rem", "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "9":  { "$value": "2.25rem", "$type": "dimension" },
    "10": { "$value": "2.5rem",  "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "14": { "$value": "3.5rem",  "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "20": { "$value": "5rem",    "$type": "dimension" },
    "24": { "$value": "6rem",    "$type": "dimension" },
    "32": { "$value": "8rem",    "$type": "dimension" },
    "40": { "$value": "10rem",   "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "xs":   { "$value": "1px",   "$type": "dimension" },
    "sm":   { "$value": "2px",   "$type": "dimension" },
    "md":   { "$value": "3px",   "$type": "dimension", "$description": "Default des swiss/designsystem" },
    "lg":   { "$value": "5px",   "$type": "dimension" },
    "xl":   { "$value": "8px",   "$type": "dimension" },
    "2xl":  { "$value": "12px",  "$type": "dimension" },
    "full": { "$value": "9999px","$type": "dimension" }
  },

  "border": {
    "width": {
      "none": { "$value": "0",   "$type": "dimension" },
      "hair": { "$value": "1px", "$type": "dimension" },
      "thin": { "$value": "2px", "$type": "dimension" },
      "thick":{ "$value": "3px", "$type": "dimension" }
    }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "sm":   { "$value": "0 1px 2px rgba(0,0,0,.05)", "$type": "shadow" },
    "md":   { "$value": "0 1px 2px rgba(0,0,0,.06), 0 1px 5px rgba(0,0,0,.08)", "$type": "shadow" },
    "lg":   { "$value": "0 2px 4px -1px rgba(0,0,0,.06), 0 4px 10px -1px rgba(0,0,0,.08)", "$type": "shadow" },
    "xl":   { "$value": "0 2px 6px -1px rgba(0,0,0,.06), 0 5px 20px -3px rgba(0,0,0,.08)", "$type": "shadow" },
    "2xl":  { "$value": "0 6px 10px -5px rgba(0,0,0,.06), 0 15px 25px -3px rgba(0,0,0,.09)", "$type": "shadow" },
    "3xl":  { "$value": "0 10px 20px rgba(0,0,0,.06), 1px 10px 70px -8px rgba(0,0,0,.13)", "$type": "shadow" }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration" },
      "fast":    { "$value": "120ms", "$type": "duration" },
      "base":    { "$value": "220ms", "$type": "duration" },
      "slow":    { "$value": "360ms", "$type": "duration" },
      "slower":  { "$value": "600ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)",    "$type": "cubicBezier" },
      "entrance": { "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)","$type": "cubicBezier" },
      "exit":     { "$value": "cubic-bezier(0.3, 0, 0.8, 0.15)","$type": "cubicBezier" },
      "emphasis": { "$value": "cubic-bezier(0.34, 1.4, 0.64, 1)","$type": "cubicBezier" }
    }
  },

  "breakpoint": {
    "xs":  { "$value": "480px",  "$type": "dimension" },
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1544px", "$type": "dimension" },
    "3xl": { "$value": "1920px", "$type": "dimension" }
  },

  "layer": {
    "base":     { "$value": "0",    "$type": "number" },
    "raised":   { "$value": "10",   "$type": "number" },
    "sticky":   { "$value": "100",  "$type": "number" },
    "header":   { "$value": "200",  "$type": "number" },
    "drawer":   { "$value": "300",  "$type": "number" },
    "overlay":  { "$value": "400",  "$type": "number" },
    "modal":    { "$value": "500",  "$type": "number" },
    "toast":    { "$value": "600",  "$type": "number" },
    "skiplink": { "$value": "700",  "$type": "number" }
  }
}
